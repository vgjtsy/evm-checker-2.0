# EVM CHECKER CONFIGURATION
# by @polydao — https://x.com/polydao

# Core settings (defaults)
# DEFAULT_NETWORK=arbitrum
BATCH_SIZE=200
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# File paths
WALLETS_FILE=wallets.txt
RESULTS_DIR=results

# Logging
ENABLE_LOGGING=true

# UI
ENABLE_PROGRESS_BAR=true

# USD valuation (prices from DefiLlama — a single batched request per run,
# regardless of how many wallets you check)
ENABLE_USD_PRICES=true

# Dust filter for the *_nonzero.csv files:
# 0 = include any wallet with a non-zero balance
# 5 = only wallets worth >= $5
DUST_THRESHOLD_USD=0

# Concurrent RPC request limit per network (protects against public RPC rate limits)
MAX_CONCURRENT_REQUESTS=5

# "All networks" mode: skip testnets and how many networks to check in parallel
EXCLUDE_TESTNETS=true
ALL_NETWORKS_CONCURRENCY=3

# Custom RPC URLs
# To override the RPC for a network, use the format RPC_URL_[NETWORK]="url"
# Multiple URLs separated by commas act as automatic fallbacks:
# RPC_URL_ARBITRUM="https://arb1.arbitrum.io/rpc"
# RPC_URL_BASE="https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.drpc.org"
# RPC_URL_OPTIMISM="https://mainnet.optimism.io"
# RPC_URL_POLYGON="https://polygon-bor-rpc.publicnode.com"
